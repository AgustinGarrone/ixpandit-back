#Cache configuración
POKEAPI_CACHE_TTL_MS=86400000
POKEAPI_CACHE_MAX_DETAILS=300
POKEAPI_CACHE_MAX_TYPES=20
POKEAPI_CACHE_MAX_PAGES=30

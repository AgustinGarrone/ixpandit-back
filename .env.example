DATABASE_URL="postgresql://admin:admin@db:5432/gts-pokemon-db"
JWT_SECRET="your-jwt-secret"
POKEAPI_BASE_URL="https://pokeapi.co/api/v2"

# Rate limiting 
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=100
THROTTLE_AUTH_TTL_MS=60000

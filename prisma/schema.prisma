generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                String            @id @default(uuid())
  username          String            @db.VarChar(15)
  email             String            @unique
  password          String            @db.VarChar(255)
  initialPokemons   Boolean?          @default(false)
  favorites         FavoritePokemon[]

  @@map("users")
}

model FavoritePokemon {
  id        String   @id @default(uuid())
  userId    String
  pokeapiId Int
  name      String
  imageUrl  String
  type      String
  abilities String[]
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, pokeapiId])
  @@map("favorite_pokemon")
}
